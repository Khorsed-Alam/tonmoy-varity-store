# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# App Configuration
VITE_APP_NAME=Tonmoy Varity Store
VITE_APP_NAME_BN=তন্ময় ভ্যারাইটি স্টোর
VITE_CURRENCY_SYMBOL=৳
VITE_DELIVERY_FEE=50
VITE_FREE_DELIVERY_THRESHOLD=500

# IMPORTANT: NEVER put your service_role key here!
# The service_role key is only used in Supabase Edge Functions (server-side).
