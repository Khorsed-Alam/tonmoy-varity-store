# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# App Configuration
VITE_APP_NAME=Tonmoy Varity Store
VITE_APP_NAME_BN=তন্ময় ভ্যারাইটি স্টোর
VITE_CURRENCY_SYMBOL=৳
VITE_DELIVERY_FEE=50
VITE_FREE_DELIVERY_THRESHOLD=500

# Fast Email Delivery via Resend (Recommended for 1-2s delivery)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Tonmoy Varity Store <onboarding@resend.dev>

# Gmail SMTP Configuration (Fallback if Resend is not configured)
# IMPORTANT: Generate Google App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="মেসার্স তন্ময় ভ্যারাইটি স্টোর" <your-email@gmail.com>

# Supabase Service Role Key (Server-Side Only)
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
# Used securely by the backend for direct password reset updates.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
